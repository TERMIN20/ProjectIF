# Raspberry Pi SMB/CIFS share used by docker-compose
PI_SHARE_HOST=10.19.240.214
PI_SHARE_NAME=pic_shared
PI_SHARE_USER=vikram
PI_SHARE_PASSWORD=automation
PI_SHARE_VERS=3.0

# Host paths used by docker-compose volume mounts
MASK_OUTPUT_DIR_HOST=./masked
STATE_DIR_HOST=./state

# Hugging Face access for Meta SAM3 gated checkpoint downloads.
# Request access to the SAM3 model repo, then set a read token here.
HF_TOKEN=

# Pipeline behavior
CHECK_INTERVAL_SECONDS=60
FILE_STABLE_SECONDS=30
PROMPT_TEXT=plant
LOG_LEVEL=INFO
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tif,.tiff
DEVICE=gpu-required
